@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title C4 Level 2 Container Diagram: Airbus Telemetry Defense Platform

Person(qaEngineer, "Airbus QA & Security Engineer")

System_Boundary(platformBoundary, "Airbus Telemetry Defense Platform") {
    Container(edgeGateway, "Airbus Edge Gateway", "Python", "Generates UUID nonces and HMAC signatures for native OPC UA tool telemetry.")
    Container(mqttBroker, "Industrial Message Broker", "amqtt (Python)", "High-throughput message queue routing unencrypted telemetry topics.")
    Container(dashboard, "Live Defense Dashboard", "Streamlit", "Airbus SOC Web App. Enforces Replay & Cryptographic validation.")
    Container(mlEngine, "ML Detection Engine", "Scikit-Learn", "Unsupervised Isolation Forest catching unnatural mechanical correlations.")
}

System_Ext(smartTools, "Airbus Drilling Units", "Hardware")
System_Ext(attacker, "Compromised Maintenance Laptop", "Adversary")

Rel(smartTools, edgeGateway, "Native OPC UA signals", "OPC UA")
Rel(edgeGateway, mqttBroker, "Publishes secured telemetry", "MQTT")
Rel(attacker, mqttBroker, "Injects spoofed 'PASS' telemetry", "MQTT (Unencrypted)")
Rel(mqttBroker, dashboard, "Subscribes to live stream", "MQTT")
Rel(dashboard, mlEngine, "Validates Thrust/Torque Physics", "In-memory")
Rel(qaEngineer, dashboard, "Views SOC alerts", "HTTPS")

Note right of edgeGateway: Security Control: Cryptographic Signing\nProtocol: MQTT
Note bottom of dashboard: Security Control: Replay Detection

SHOW_LEGEND()
@enduml
