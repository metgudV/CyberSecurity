@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title C4 Level 1 System Context: Aerospace Final Assembly Line (FAL) Telemetry Defense Platform

Person(qaEngineer, "QA & Security Engineer", "Monitors aircraft structural integrity and investigates SOC alerts on the assembly line.")

Enterprise_Boundary(enterprise, "Commercial Aircraft Manufacturing Enterprise") {
    System(telemetryPlatform, "Aerospace Final Assembly Line (FAL) Telemetry Defense Platform", "Secures, validates, and analyzes high-frequency Thrust & Torque telemetry for tampering using ML.")
    System_Ext(mes, "Enterprise Manufacturing Execution System (MES)", "Logs official QA passes for aircraft section assembly.")
    
    Boundary(factoryBoundary, "Commercial Aircraft Factory Floor Trust Boundary") {
        System_Ext(smartTools, "Smart Drilling & Fastening Units", "Generates raw Thrust & Torque telemetry profiles.")
        Note right of smartTools
            Security Control: HMAC-SHA256 
            Payload Signing at the edge.
        End note
    }
}

Rel_D(qaEngineer, telemetryPlatform, "Monitors threats and telemetry via", "HTTPS")
Rel(telemetryPlatform, mes, "Sends validated QA logs to", "REST API")
Rel(smartTools, telemetryPlatform, "Streams signed telemetry", "MQTT (Port 1883)")

SHOW_LEGEND()
@enduml
